# THE INTERNET TIMES — ENVIRONMENT
#
# Copy this file to .env.local and fill in the four values below.
# .env.local is gitignored; never commit real keys.
#
#     cp .env.example .env.local
#
# There are only four things to set. Nothing else is required.
#
# Deploying to Render? These same four values go in the Render dashboard
# (declared as `sync: false` in render.yaml), not in a file. See the README's
# "Deploy to Render" section.


# 1. DATABASE_URL  (required)
#
# Supabase: dashboard > your project > Connect > ORMs / Postgres, and copy the
# "Connection string" in URI form. Use the pooler host on port 5432.
#
# WHERE: https://supabase.com/dashboard  ->  your project  ->  Connect
#
DATABASE_URL=postgresql://postgres.PROJECTREF:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres


# 2. STRIPE_SECRET_KEY  (required to take payments)
#
# Keep "Test mode" switched on in the Stripe dashboard. A test key starts with
# sk_test_ and no real card is ever charged.
#
# WHERE: https://dashboard.stripe.com/test/apikeys
#
# This value stays on the server. It is never sent to the browser.
#
STRIPE_SECRET_KEY=sk_test_...


# 3. STRIPE_PUBLISHABLE_KEY  (required to take payments)
#
# Same page as above. Starts with pk_test_. This one is designed to be public
# and is served to the browser deliberately.
#
STRIPE_PUBLISHABLE_KEY=pk_test_...


# 4. STRIPE_WEBHOOK_SECRET  (required for a purchase to complete)
#
# Payment is confirmed only by Stripe's signed webhook, so without this a
# purchase can be paid for but never becomes permanent.
#
# For local development, install the Stripe CLI and run:
#
#     stripe listen --forward-to localhost:3000/api/stripe/webhook
#
# It prints a line like "Ready! Your webhook signing secret is whsec_abc123".
# Copy that value here. Leave the command running while you test.
#
# For a deployed site, create the endpoint at
# https://dashboard.stripe.com/test/webhooks pointing at
# https://your-domain/api/stripe/webhook, subscribe to
# "checkout.session.completed", and copy the signing secret it shows.
#
STRIPE_WEBHOOK_SECRET=whsec_...


# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Port to listen on. Defaults to 3000.
# PORT=3000

# The origin Stripe should return buyers to. Only needed when the server sits
# behind a tunnel or proxy that it cannot detect from request headers, e.g.
# PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.app
# PUBLIC_BASE_URL=
