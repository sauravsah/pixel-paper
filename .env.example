# PIXEL PAPER — ENVIRONMENT
#
# Copy this file to .env.local and fill in the values below.
# .env.local is gitignored; never commit real keys.
#
#     cp .env.example .env.local
#
# Deploying to Render? These same values go in the Render dashboard
# (declared as `sync: false` in render.yaml), not in a file. See the README's
# "Deploy to Render" section.


# 1. DATABASE_URL  (required)
#
# Supabase: dashboard > your project > Connect > ORMs / Postgres, and copy the
# "Connection string" in URI form. Use the pooler host on port 5432.
#
# WHERE: https://supabase.com/dashboard  ->  your project  ->  Connect
#
DATABASE_URL=postgresql://postgres.PROJECTREF:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Supabase project CA certificate (PEM). Required for remote TLS verification.
DATABASE_SSL_CA=


# 2. DODO PAYMENTS  (required to take payments)
#
# DODO_PAYMENTS_API_KEY  (required to take Dodo payments)
#
# Dodo Payments is the one and only payment provider. Keep the account in test
# mode while developing — no real card is ever charged. This value stays on the
# server and is never sent to the browser.
#
# WHERE: https://app.dodopayments.com  ->  Developer  ->  API Keys
#
DODO_PAYMENTS_API_KEY=


# DODO_PRODUCT_ID  (required to take Dodo payments)
#
# The newspaper charges a different amount for every rectangle, so it sells
# against a single "pay what you want" product and sets the price per checkout.
# Create that product once and copy its id here.
#
# WHERE: https://app.dodopayments.com  ->  Products  ->  create a
#        "pay what you want" product  ->  copy its product id
#
DODO_PRODUCT_ID=


# DODO_PAYMENTS_WEBHOOK_KEY  (required for a Dodo purchase to complete)
#
# Payment is confirmed only by Dodo's signed webhook, so without this a purchase
# can be paid for but never becomes permanent. Add a webhook endpoint in the Dodo
# dashboard pointing at your server's /api/webhooks/dodo, subscribe it to
# "payment.succeeded" (and "payment.failed"), and copy the signing secret it
# shows.
#
# WHERE: https://app.dodopayments.com  ->  Developer  ->  Webhooks  ->
#        add endpoint  ->  https://your-domain/api/webhooks/dodo
#
DODO_PAYMENTS_WEBHOOK_KEY=


# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Which Dodo environment to talk to: test_mode (default) or live_mode. Anything
# unset, misspelled or blank stays on the safe side and uses test mode; only an
# explicit live_mode ever charges real cards.
# DODO_PAYMENTS_ENVIRONMENT=test_mode

# Port to listen on. Defaults to 3000.
# PORT=3000

# Optional isolated E2E configuration. The database-writing suite refuses to
# run unless all values are supplied and the target is non-production.
# E2E_BASE_URL=http://localhost:4310
# E2E_DATABASE_URL=postgresql://...
# E2E_DATABASE_SSL_CA=
# E2E_ALLOW_DATABASE_WRITES=true

# The origin Dodo should return buyers to. Only needed when the server sits
# behind a tunnel or proxy that it cannot detect from request headers, e.g.
# PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.app
# PUBLIC_BASE_URL=
